# Copy to .env and fill with real values. NEVER commit the filled file.
# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# NextAuth — generate with: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate-with-openssl-rand-hex-32>
SEED_ADMIN_EMAIL=<admin-email>
SEED_ADMIN_PASSWORD=<strong-unique-password>

# Public base URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics — leave blank to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# ImageKit
IMAGEKIT_PUBLIC_KEY=<public-key>
IMAGEKIT_PRIVATE_KEY=<private-key>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<id>
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=<public-key>
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<id>

# Email (Resend — https://resend.com/api-keys)
# EMAIL_FROM domain must be verified in the Resend dashboard.
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM="Your Shop <noreply@example.com>"
ADMIN_EMAIL=<admin-email>
ADMIN_NOTIFICATION_EMAIL=<admin-email>

# Upstash Redis
UPSTASH_REDIS_REST_URL=<upstash-url>
UPSTASH_REDIS_REST_TOKEN=<upstash-token>
