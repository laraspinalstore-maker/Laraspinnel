# next-auth declares nodemailer ^7 as an OPTIONAL peer (used only by its unused
# EmailProvider). This project uses CredentialsProvider and calls nodemailer 9
# directly from lib/email/sendEmail.ts, so the optional peer mismatch is inert.
# Required so `npm ci` on Vercel/CI resolves the same tree as local installs.
legacy-peer-deps=true
